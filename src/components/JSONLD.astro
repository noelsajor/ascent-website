---
const { type = 'WebSite', title, description, url = Astro.url, image } = Astro.props;

// Safely serialize data for embedding inside a <script type="application/ld+json">
// element. JSON.stringify() alone does not escape "</script>", so CMS-controlled
// text (e.g. a post title) could close the script tag and inject markup. Line/
// paragraph separators are also escaped since they are valid in JSON strings but
// were historically treated as line terminators by non-strict JS parsers.
const LINE_SEPARATOR = String.fromCharCode(0x2028);
const PARAGRAPH_SEPARATOR = String.fromCharCode(0x2029);

function safeJsonLd(data) {
  return JSON.stringify(data)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026')
    .split(LINE_SEPARATOR).join('\\u2028')
    .split(PARAGRAPH_SEPARATOR).join('\\u2029');
}

const organizationData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Ascent Mgnt",
  "url": "https://ascentmgnt.com",
  "logo": "https://ascentmgnt.com/assets/ascent_logo.svg",
  "description": "Done-for-you brand creation and growth agency."
};

const webSiteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": title || "Ascent Mgnt",
  "url": url,
  "description": description
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://ascentmgnt.com/"
    }
  ]
};

// If it's a blog post, add BlogPosting
let blogPostingData = null;
if (type === 'BlogPosting') {
  blogPostingData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": image,
    "url": url,
    "author": {
      "@type": "Organization",
      "name": "Ascent Mgnt"
    }
  };
}
---

<script type="application/ld+json" set:html={safeJsonLd(organizationData)} />
<script type="application/ld+json" set:html={safeJsonLd(webSiteData)} />
<script type="application/ld+json" set:html={safeJsonLd(breadcrumbData)} />
{blogPostingData && <script type="application/ld+json" set:html={safeJsonLd(blogPostingData)} />}
